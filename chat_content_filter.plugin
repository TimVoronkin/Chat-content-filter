_SET_MEASURED_DIMENSION = None


def get_set_measured_dimension_method():
    """Lazily locates and caches View.setMeasuredDimension(int, int)."""
    global _SET_MEASURED_DIMENSION
    if _SET_MEASURED_DIMENSION is None:
        try:
            from java.lang import Integer
            int_type = Integer.TYPE
            ViewClass = find_class("android.view.View")
            if ViewClass:
                for m in ViewClass.getDeclaredMethods():
                    if m.getName() == "setMeasuredDimension":
                        pts = m.getParameterTypes()
                        if len(pts) == 2 and pts[0] == int_type and pts[1] == int_type:
                            m.setAccessible(True)
                            _SET_MEASURED_DIMENSION = m
                            break
        except Exception:
            pass
    return _SET_MEASURED_DIMENSION


def _set_zero_dimensions(view):
    """Sets measured dimensions of the view to 0x0 to eliminate vertical gaps."""
    m = get_set_measured_dimension_method()
    if m is not None:
        try:
            from java.lang import Integer
            m.invoke(view, [Integer.valueOf(0), Integer.valueOf(0)])
            return True
        except Exception:
            try:
                m.invoke(view, 0, 0)
                return True
            except Exception:
                pass
    return False


class LongPressRunnable(dynamic_proxy(find_class("java.lang.Runnable"))):
    def __init__(self, touch_listener, view, plugin, fragment):
        super().__init__()
        self.touch_listener = touch_listener
        self.view = view
        self.plugin = plugin
        self.fragment = fragment

    def run(self):
        self.touch_listener.long_pressed = True
        try:
            if HapticFeedbackConstants is not None:
                self.view.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS)
        except Exception:
            pass
        self.plugin.open_filter_dialog(self.fragment)


class HeaderTouchListener(dynamic_proxy(find_class("android.view.View$OnTouchListener"))):
    """Handles both short tap (toggle) and long press (open dialog) on the header button."""
    def __init__(self, plugin, fragment):
        super().__init__()
        self.plugin = plugin
        self.fragment = fragment
        self.long_press_runnable = None
        self.long_pressed = False
        self.timeout = DEFAULT_LONG_PRESS_TIMEOUT

    def onTouch(self, view, event):
        try:
            action = event.getAction()

            if action == MotionEvent.ACTION_DOWN:
                self.long_pressed = False
                self.long_press_runnable = LongPressRunnable(self, view, self.plugin, self.fragment)
                view.postDelayed(self.long_press_runnable, self.timeout)
                return False

            elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                if self.long_press_runnable is not None:
                    view.removeCallbacks(self.long_press_runnable)
                    self.long_press_runnable = None

                if action == MotionEvent.ACTION_UP and self.long_pressed:
                    # Consume UP event so onClick does not toggle filter
                    return True
        except Exception:
            pass
        return False


class SwitchChangeListener(dynamic_proxy(CompoundButton.OnCheckedChangeListener)):
    def __init__(self, key, plugin, fragment):
        super().__init__()
        self.key = key
        self.plugin = plugin
        self.fragment = fragment

    def onCheckedChanged(self, buttonView, isChecked):
        self.plugin.set_setting(self.key, isChecked)
        if self.fragment:
            run_on_ui_thread(lambda: self.plugin.refresh_chat_view(self.fragment))


class ChatActivityHook(MethodHook):
    def __init__(self, plugin, action_name):
        super().__init__()
        self.plugin = plugin
        self.action_name = action_name

    def after_hooked_method(self, param):
        try:
            fragment = param.thisObject
            if not fragment:
                return

            if self.action_name == "onFragmentDestroy":
                self.plugin.on_chat_destroy(fragment)
                return

            if self.action_name in ("createView", "onResume"):
                run_on_ui_thread(lambda: self.plugin.attach_header_button(fragment))

            if self.action_name == "onResume":
                self.plugin.scan_messages_incremental(fragment, full=True)
                run_on_ui_thread(lambda: self.plugin.refresh_chat_view(fragment))

            if self.action_name == "processLoadedMessages":
                self.plugin.on_messages_loaded(fragment)
        except Exception:
            pass


class MessageCellHook(MethodHook):
    """Hooks setMessageObject on ChatMessageCell and ChatActionCell to adjust visibility on bind."""
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            cell = param.thisObject
            if not cell:
                return
            self.plugin.apply_cell_visibility(cell)
        except Exception:
            pass


class MessageCellMeasureHook(MethodHook):
    """Hooks onMeasure on ChatMessageCell and ChatActionCell to collapse hidden rows to 0x0 instantly."""
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if not self.plugin.is_enabled():
                return

            cell = param.thisObject
            if not cell:
                return

            is_hidden = False
            if cell.getVisibility() == View.GONE:
                is_hidden = True
            else:
                msg = self.plugin.get_cell_message_object(cell)
                if msg is not None and not self.plugin.is_message_visible(msg):
                    cell.setVisibility(View.GONE)
                    is_hidden = True

            if is_hidden:
                # Fully collapse LayoutParams dimensions and margins
                lp = cell.getLayoutParams()
                if lp is not None:
                    if lp.height != 0 or lp.width != 0:
                        lp.height = 0
                        lp.width = 0
                    if hasattr(lp, "topMargin") and lp.topMargin != 0:
                        lp.topMargin = 0
                    if hasattr(lp, "bottomMargin") and lp.bottomMargin != 0:
                        lp.bottomMargin = 0

                # Set 0x0 measurement to eliminate empty gaps in RecyclerView
                if _set_zero_dimensions(cell):
                    param.setResult(None)
        except Exception:
            pass


class ChatContentFilterPlugin(BasePlugin):
    def on_plugin_load(self):
        self._loaded = True
        self.unhook_objs = []
        self.visible_days = set()
        self._scanned_message_count = 0
        self._current_fragment = None
        self._msg_visibility_cache = {}
        self._last_loaded_time = 0

        try:
            self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    item_id="chat_content_filter_action",
                    text="Filter Messages",
                    subtext="Open content filter options",
                    icon="msg_filter",
                    on_click=self.on_menu_action_click
                )
            )
        except Exception:
            pass

        self.apply_hooks()
        run_on_ui_thread(lambda: BulletinHelper.show_info("Chat Content Filter enabled"))

    def on_plugin_unload(self):
        self._loaded = False
        for unhook in getattr(self, "unhook_objs", []):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self.unhook_objs.clear()
        self.visible_days.clear()
        self._scanned_message_count = 0
        self._current_fragment = None
        self._msg_visibility_cache.clear()

        try:
            from client_utils import get_last_fragment
            fragment = get_last_fragment()
            if fragment and "ChatActivity" in fragment.getClass().getSimpleName():
                run_on_ui_thread(lambda: self.refresh_chat_view(fragment))
        except Exception:
            pass

    def on_chat_destroy(self, fragment):
        if fragment == self._current_fragment:
            self.visible_days.clear()
            self._scanned_message_count = 0
            self._current_fragment = None
            self._msg_visibility_cache.clear()

    def set_setting(self, key, value):
        super().set_setting(key, value)
        self._msg_visibility_cache.clear()
        self.visible_days.clear()
        self._scanned_message_count = 0

    def is_enabled(self) -> bool:
        return bool(self.get_setting("plugin_enabled", True))

    def get_show_my_messages(self) -> bool:
        """Returns True if the user's own messages should be shown."""
        val = self.get_setting("show_my_messages", None)
        if val is not None:
            return bool(val)
        old_hide = self.get_setting("hide_my_messages", None)
        if old_hide is not None:
            return not bool(old_hide)
        return True

    def create_settings(self):
        return [
            Header(text="General Settings"),
            Switch(
                key="plugin_enabled",
                text="Enable Content Filter",
                default=True,
                subtext="Master toggle to filter messages in all chats",
                on_change=lambda val: self.set_setting("plugin_enabled", val)
            ),
            Header(text="Sender Filters"),
            Switch(
                key="show_my_messages",
                text="Show My Messages",
                default=True,
                subtext="Show messages sent by yourself",
                on_change=lambda val: self.set_setting("show_my_messages", val)
            ),
            Header(text="Visible Message Types"),
            Switch(
                key="show_text",
                text="Plain Text Messages",
                default=False,
                subtext="Show regular text messages",
                on_change=lambda val: self.set_setting("show_text", val)
            ),
            Switch(
                key="show_photos",
                text="Photos",
                default=True,
                subtext="Show photo attachments",
                on_change=lambda val: self.set_setting("show_photos", val)
            ),
            Switch(
                key="show_videos",
                text="Videos & Video Notes",
                default=True,
                subtext="Show videos and video messages",
                on_change=lambda val: self.set_setting("show_videos", val)
            ),
            Switch(
                key="show_documents",
                text="Files & Documents",
                default=True,
                subtext="Show documents, PDFs, archives, etc.",
                on_change=lambda val: self.set_setting("show_documents", val)
            ),
            Switch(
                key="show_audio",
                text="Voice Notes & Music",
                default=False,
                subtext="Show voice messages and audio files",
                on_change=lambda val: self.set_setting("show_audio", val)
            ),
            Switch(
                key="show_links",
                text="Links & Web Previews",
                default=False,
                subtext="Show messages with web page previews",
                on_change=lambda val: self.set_setting("show_links", val)
            ),
            Switch(
                key="show_polls",
                text="Polls",
                default=False,
                subtext="Show polls and quizzes",
                on_change=lambda val: self.set_setting("show_polls", val)
            ),
            Switch(
                key="show_stickers",
                text="Stickers & GIFs",
                default=False,
                subtext="Show stickers and animated GIFs",
                on_change=lambda val: self.set_setting("show_stickers", val)
            ),
            Switch(
                key="show_calls",
                text="Calls & System Actions",
                default=False,
                subtext="Show call logs and system join/pin messages",
                on_change=lambda val: self.set_setting("show_calls", val)
            ),
            Divider(text="Configure which message categories should remain visible.")
        ]

    def create_vector_drawable(self, activity, path_data):
        """Creates a smooth vector BitmapDrawable using the given SVG path."""
        try:
            try:
                from androidx.core.graphics import PathParser
            except Exception:
                try:
                    from android.util import PathParser
                except Exception:
                    PathParser = None

            if not PathParser:
                return None

            from android.graphics import Bitmap, Canvas, Paint, Matrix
            from android.graphics.drawable import BitmapDrawable
            from org.telegram.ui.ActionBar import Theme

            size_dp = AndroidUtilities.dp(24) if AndroidUtilities else 72
            if size_dp <= 0:
                size_dp = 72

            path = PathParser.createPathFromPathData(path_data)
            if not path:
                return None

            scale = float(size_dp) / 24.0
            matrix = Matrix()
            matrix.setScale(scale, scale)
            path.transform(matrix)

            bitmap = Bitmap.createBitmap(size_dp, size_dp, Bitmap.Config.ARGB_8888)
            canvas = Canvas(bitmap)

            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            icon_color = 0xFFE3E3E3
            try:
                if hasattr(Theme, "key_actionBarDefaultIcon"):
                    icon_color = Theme.getColor(Theme.key_actionBarDefaultIcon)
            except Exception:
                pass

            paint.setColor(icon_color)
            paint.setStyle(Paint.Style.FILL)
            canvas.drawPath(path, paint)

            res = activity.getResources() if activity else None
            return BitmapDrawable(res, bitmap)
        except Exception as e:
            if hasattr(self, "logger") and self.logger:
                self.logger.error(f"create_vector_drawable error: {e}")
            return None

    def find_filter_icon_id(self, activity):
        try:
            from org.telegram.messenger import R
            for field in dir(R.drawable):
                field_lower = field.lower()
                if "filter" in field_lower or "msg_filter" in field_lower:
                    icon_id = int(getattr(R.drawable, field, 0))
                    if icon_id > 0:
                        return icon_id
        except Exception:
            pass

        if activity:
            try:
                pkg = str(activity.getPackageName())
                res = activity.getResources()
                for name in ("ic_ab_filter", "ic_filter", "filter", "msg_filter", "ic_bar_filter", "msg_customize", "msg_list"):
                    icon_id = int(res.getIdentifier(name, "drawable", pkg))
                    if icon_id > 0:
                        return icon_id
            except Exception:
                pass

        try:
            from org.telegram.messenger import R
            return int(getattr(R.drawable, "msg_list", 0))
        except Exception:
            return 0

    def get_cell_message_object(self, cell):
        """Safely retrieves MessageObject from either ChatMessageCell or ChatActionCell."""
        if not cell:
            return None
        try:
            if hasattr(cell, "getMessageObject") and callable(cell.getMessageObject):
                m = cell.getMessageObject()
                if m is not None:
                    return m
        except Exception:
            pass
        try:
            m = getattr(cell, "currentMessageObject", None)
            if m is not None:
                return m
        except Exception:
            pass
        try:
            return get_private_field(cell, "currentMessageObject")
        except Exception:
            pass
        return None

    def apply_cell_visibility(self, cell):
        """Configures visibility and dimensions directly on the LayoutParams object."""
        if not cell:
            return
        try:
            from android.view import ViewGroup

            if not self.is_enabled():
                if cell.getVisibility() != View.VISIBLE:
                    cell.setVisibility(View.VISIBLE)
                lp = cell.getLayoutParams()
                if lp is not None and (lp.height == 0 or lp.width == 0):
                    lp.height = ViewGroup.LayoutParams.WRAP_CONTENT
                    lp.width = ViewGroup.LayoutParams.MATCH_PARENT
                return

            msg = self.get_cell_message_object(cell)
            if msg is not None:
                visible = self.is_message_visible(msg)
                if not visible:
                    if cell.getVisibility() != View.GONE:
                        cell.setVisibility(View.GONE)
                    lp = cell.getLayoutParams()
                    if lp is not None:
                        lp.height = 0
                        lp.width = 0
                        if hasattr(lp, "topMargin"):
                            lp.topMargin = 0
                        if hasattr(lp, "bottomMargin"):
                            lp.bottomMargin = 0
                else:
                    if cell.getVisibility() != View.VISIBLE:
                        cell.setVisibility(View.VISIBLE)
                    lp = cell.getLayoutParams()
                    if lp is not None and (lp.height == 0 or lp.width == 0):
                        lp.height = ViewGroup.LayoutParams.WRAP_CONTENT
                        lp.width = ViewGroup.LayoutParams.MATCH_PARENT
        except Exception:
            pass

    def update_header_button_state(self, fragment):
        if not fragment:
            return
        try:
            bar = fragment.getActionBar()
            if not bar:
                return
            menu = bar.createMenu()
            if not menu:
                return
            item = menu.getItem(FILTER_HEADER_ID)
            if not item:
                return

            activity = fragment.getParentActivity()
            is_enabled = self.is_enabled()
            path_data = PATH_VISIBILITY_OFF if is_enabled else PATH_VISIBILITY_ON
            drawable = self.create_vector_drawable(activity, path_data)
            if drawable and hasattr(item, "setIcon"):
                item.setIcon(drawable)
            item.setAlpha(1.0)
        except Exception:
            pass

    def attach_header_button(self, fragment):
        if not self._loaded or not fragment:
            return
        try:
            bar = fragment.getActionBar()
            if not bar:
                return
            menu = bar.createMenu()
            if not menu:
                return

            if fragment != getattr(self, "_current_fragment", None):
                self._current_fragment = fragment
                self.visible_days.clear()
                self._scanned_message_count = 0
                self._msg_visibility_cache.clear()

            item = menu.getItem(FILTER_HEADER_ID)
            if item is not None:
                self.update_header_button_state(fragment)
                return

            activity = fragment.getParentActivity()

            is_enabled = self.is_enabled()
            path_data = PATH_VISIBILITY_OFF if is_enabled else PATH_VISIBILITY_ON
            drawable = self.create_vector_drawable(activity, path_data)
            fallback_icon = self.find_filter_icon_id(activity) or 0

            width_dp = AndroidUtilities.dp(48) if AndroidUtilities else 144
            item = menu.addItemWithWidth(FILTER_HEADER_ID, fallback_icon, width_dp, "Filter Messages")
            if item and drawable:
                try:
                    item.setIcon(drawable)
                except Exception:
                    pass

            if item:
                try:
                    count = menu.getChildCount()
                    if count > 1:
                        menu.removeView(item)
                        menu.addView(item, count - 2)
                except Exception:
                    pass

                plugin_self = self
                touch_listener = HeaderTouchListener(plugin_self, fragment)
                item.setOnTouchListener(touch_listener)

                def handle_short_click(view):
                    if getattr(touch_listener, "long_pressed", False):
                        touch_listener.long_pressed = False
                        return
                    new_state = not plugin_self.is_enabled()
                    plugin_self.set_setting("plugin_enabled", new_state)
                    plugin_self.update_header_button_state(fragment)
                    plugin_self.refresh_chat_view(fragment)
                    status_text = "Content filter enabled" if new_state else "Content filter disabled"
                    try:
                        BulletinHelper.show_info(status_text)
                    except Exception:
                        pass

                item.setOnClickListener(OnClickListener(handle_short_click))

                def handle_long_click(view):
                    touch_listener.long_pressed = True
                    plugin_self.open_filter_dialog(fragment)
                    return True

                item.setLongClickable(True)
                item.setOnLongClickListener(OnLongClickListener(handle_long_click))

                self.update_header_button_state(fragment)
        except Exception as e:
            if hasattr(self, "logger") and self.logger:
                self.logger.error(f"attach_header_button error: {e}")

    def open_filter_dialog(self, fragment):
        activity = fragment.getParentActivity() if fragment else None
        if not activity:
            return

        from android.graphics.drawable import GradientDrawable

        text_color = 0xFFFFFFFF
        subtext_color = 0xFFAAAAAA
        divider_color = 0x22888888
        accent_color = 0xFF50A7EA
        card_bg = 0x18FFFFFF

        try:
            from org.telegram.ui.ActionBar import Theme
            if hasattr(Theme, "key_dialogTextBlack"):
                text_color = Theme.getColor(Theme.key_dialogTextBlack)
            elif hasattr(Theme, "key_windowBackgroundWhiteBlackText"):
                text_color = Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)

            if hasattr(Theme, "key_dialogTextGray"):
                subtext_color = Theme.getColor(Theme.key_dialogTextGray)
            elif hasattr(Theme, "key_windowBackgroundWhiteGrayText"):
                subtext_color = Theme.getColor(Theme.key_windowBackgroundWhiteGrayText)

            if hasattr(Theme, "key_divider"):
                divider_color = Theme.getColor(Theme.key_divider)

            if hasattr(Theme, "key_windowBackgroundWhiteBlueHeader"):
                accent_color = Theme.getColor(Theme.key_windowBackgroundWhiteBlueHeader)
            elif hasattr(Theme, "key_dialogButton"):
                accent_color = Theme.getColor(Theme.key_dialogButton)

            if hasattr(Theme, "key_dialogBackground"):
                card_bg = (Theme.getColor(Theme.key_dialogBackground) & 0x00FFFFFF) | 0x1F000000
        except Exception:
            pass

        builder = AlertDialogBuilder(activity)
        builder.set_title("Content Filter Options")

        container = LinearLayout(activity)
        container.setOrientation(LinearLayout.VERTICAL)
        pad = AndroidUtilities.dp(16) if AndroidUtilities else 48
        container.setPadding(pad, pad, pad, pad)

        # 1. Master Switch Card Container
        master_card = LinearLayout(activity)
        master_card.setOrientation(LinearLayout.HORIZONTAL)
        master_card_pad = AndroidUtilities.dp(12) if AndroidUtilities else 36
        master_card.setPadding(master_card_pad, master_card_pad, master_card_pad, master_card_pad)

        card_drawable = GradientDrawable()
        card_radius = float(AndroidUtilities.dp(12)) if AndroidUtilities else 36.0
        card_drawable.setCornerRadius(card_radius)
        card_drawable.setColor(card_bg)
        stroke_w = AndroidUtilities.dp(1) if AndroidUtilities else 2
        card_drawable.setStroke(stroke_w, divider_color)
        master_card.setBackground(card_drawable)

        master_text_box = LinearLayout(activity)
        master_text_box.setOrientation(LinearLayout.VERTICAL)
        master_text_box.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1.0))

        master_label = TextView(activity)
        master_label.setText("Enable Content Filter")
        master_label.setTextSize(2, 16)
        master_label.setTextColor(text_color)
        try:
            if AndroidUtilities:
                master_label.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
        except Exception:
            pass

        master_sub = TextView(activity)
        master_sub.setText("Master toggle to turn all filtering ON / OFF")
        master_sub.setTextSize(2, 12)
        master_sub.setTextColor(subtext_color)
        sub_pad = AndroidUtilities.dp(2) if AndroidUtilities else 4
        master_sub.setPadding(0, sub_pad, 0, 0)

        master_text_box.addView(master_label)
        master_text_box.addView(master_sub)

        master_sw = AndroidSwitch(activity)
        master_sw.setChecked(bool(self.is_enabled()))

        plugin_self = self

        class MasterSwitchListener(dynamic_proxy(CompoundButton.OnCheckedChangeListener)):
            def onCheckedChanged(self, buttonView, isChecked):
                plugin_self.set_setting("plugin_enabled", isChecked)
                if fragment:
                    run_on_ui_thread(lambda: (
                        plugin_self.update_header_button_state(fragment),
                        plugin_self.refresh_chat_view(fragment)
                    ))

        master_sw.setOnCheckedChangeListener(MasterSwitchListener())

        master_card.addView(master_text_box)
        master_card.addView(master_sw)
        container.addView(master_card)

        def add_section_header(title):
            header = TextView(activity)
            header.setText(title)
            header.setTextSize(2, 12)
            header.setTextColor(accent_color)
            top_pad = AndroidUtilities.dp(16) if AndroidUtilities else 48
            bot_pad = AndroidUtilities.dp(6) if AndroidUtilities else 18
            header.setPadding(0, top_pad, 0, bot_pad)
            try:
                if AndroidUtilities:
                    header.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            except Exception:
                pass
            container.addView(header)

        def add_divider():
            div = View(activity)
            line_h = AndroidUtilities.dp(1) if AndroidUtilities else 2
            lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, line_h)
            m_top = AndroidUtilities.dp(12) if AndroidUtilities else 36
            m_bot = AndroidUtilities.dp(4) if AndroidUtilities else 12
            lp.setMargins(0, m_top, 0, m_bot)
            div.setLayoutParams(lp)
            div.setBackgroundColor(divider_color)
            container.addView(div)

        def add_switch_row(key, title, subtitle, default_val):
            row = LinearLayout(activity)
            row.setOrientation(LinearLayout.HORIZONTAL)
            r_pad = AndroidUtilities.dp(8) if AndroidUtilities else 24
            row.setPadding(0, r_pad, 0, r_pad)

            text_box = LinearLayout(activity)
            text_box.setOrientation(LinearLayout.VERTICAL)
            text_box.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1.0))

            label = TextView(activity)
            label.setText(title)
            label.setTextSize(2, 15)
            label.setTextColor(text_color)

            sub = TextView(activity)
            sub.setText(subtitle)
            sub.setTextSize(2, 12)
            sub.setTextColor(subtext_color)

            text_box.addView(label)
            text_box.addView(sub)

            sw = AndroidSwitch(activity)
            if key == "show_my_messages":
                sw.setChecked(bool(plugin_self.get_show_my_messages()))
            else:
                sw.setChecked(bool(plugin_self.get_setting(key, default_val)))
            sw.setOnCheckedChangeListener(SwitchChangeListener(key, plugin_self, fragment))

            row.addView(text_box)
            row.addView(sw)
            container.addView(row)

        # 2. Sender Filters Section (Inverted: Show My Messages)
        add_divider()
        add_section_header("SENDER FILTERS")
        add_switch_row("show_my_messages", "Show My Messages", "Show messages sent by yourself", True)

        # 3. Content Categories Section
        add_divider()
        add_section_header("CONTENT CATEGORIES")

        categories = [
            ("show_text", "Plain Text Messages", "Show regular text messages", False),
            ("show_photos", "Photos", "Show photo attachments", True),
            ("show_videos", "Videos & Video Notes", "Show videos and round video notes", True),
            ("show_documents", "Files & Documents", "Show documents, PDFs, archives, etc.", True),
            ("show_audio", "Voice Notes & Music", "Show voice messages and audio files", False),
            ("show_links", "Links & Web Previews", "Show messages with web page previews", False),
            ("show_polls", "Polls", "Show polls and quizzes", False),
            ("show_stickers", "Stickers & GIFs", "Show stickers and animated GIFs", False),
            ("show_calls", "Calls & System Actions", "Show call logs and system join/pin messages", False),
        ]

        for key, title, sub, default_val in categories:
            add_switch_row(key, title, sub, default_val)

        scroll = ScrollView(activity)
        scroll.addView(container)

        builder.set_view(scroll)
        builder.set_positive_button("Done", lambda dialog, which: (
            dialog.dismiss(),
            self.update_header_button_state(fragment),
            self.refresh_chat_view(fragment)
        ))
        builder.show()

    def is_date_object(self, msg) -> bool:
        if not msg:
            return False
        try:
            if getattr(msg, "type", -1) == 10:
                return True
            if getattr(msg, "isDateObject", False):
                return True
            if getattr(msg, "contentType", -1) == 1:
                return True
            raw = getattr(msg, "messageOwner", msg)
            action = getattr(raw, "action", None)
            if action is not None:
                cname = action.getClass().getSimpleName()
                if "Date" in cname:
                    return True
        except Exception:
            pass
        return False

    def is_outgoing_message(self, msg) -> bool:
        if not msg:
            return False
        try:
            if hasattr(msg, "isOut") and callable(msg.isOut):
                return bool(msg.isOut())
            elif hasattr(msg, "isOut") and isinstance(msg.isOut, bool):
                return bool(msg.isOut)
            if hasattr(msg, "isOutOwner") and callable(msg.isOutOwner):
                return bool(msg.isOutOwner())
            raw = getattr(msg, "messageOwner", msg)
            if getattr(raw, "out", False):
                return True
        except Exception:
            pass
        return False

    def get_message_day(self, msg):
        if not msg:
            return None
        try:
            raw = getattr(msg, "messageOwner", msg)
            ts = getattr(raw, "date", None)
            if ts is None:
                ts = getattr(msg, "date", None)
            if ts:
                return int(ts) // 86400
        except Exception:
            pass
        return None

    def is_message_content_visible(self, msg) -> bool:
        if not msg:
            return True
        try:
            raw = getattr(msg, "messageOwner", msg)

            if getattr(raw, "action", None) is not None:
                return bool(self.get_setting("show_calls", False))

            media = getattr(raw, "media", None)
            media_type = media.getClass().getSimpleName() if media else "None"

            if (hasattr(msg, "isPoll") and msg.isPoll()) or media_type == "TL_messageMediaPoll":
                return bool(self.get_setting("show_polls", False))

            if (hasattr(msg, "isSticker") and msg.isSticker()) or \
               (hasattr(msg, "isGif") and msg.isGif()) or \
               (hasattr(msg, "isAnimatedSticker") and msg.isAnimatedSticker()):
                return bool(self.get_setting("show_stickers", False))

            if (hasattr(msg, "isVoice") and msg.isVoice()) or \
               (hasattr(msg, "isMusic") and msg.isMusic()) or \
               (hasattr(msg, "isAudio") and msg.isAudio()):
                return bool(self.get_setting("show_audio", False))

            if (hasattr(msg, "isVideo") and msg.isVideo()) or \
               (hasattr(msg, "isRoundVideo") and msg.isRoundVideo()):
                return bool(self.get_setting("show_videos", True))

            if (hasattr(msg, "isPhoto") and msg.isPhoto()) or media_type == "TL_messageMediaPhoto":
                return bool(self.get_setting("show_photos", True))

            if (hasattr(msg, "isDocument") and msg.isDocument()) or media_type == "TL_messageMediaDocument":
                return bool(self.get_setting("show_documents", True))

            if media_type == "TL_messageMediaWebPage" or (hasattr(msg, "hasWebPage") and msg.hasWebPage()):
                return bool(self.get_setting("show_links", False))

            has_url = False
            try:
                entities = getattr(raw, "entities", None)
                if entities is not None:
                    for e in entities:
                        cname = e.getClass().getSimpleName()
                        if "Url" in cname or "URL" in cname:
                            has_url = True
                            break
            except Exception:
                pass

            if has_url:
                return bool(self.get_setting("show_links", False))

            if media is not None and media_type not in ("TL_messageMediaEmpty", "None"):
                return bool(self.get_setting("show_calls", False))

            return bool(self.get_setting("show_text", False))

        except Exception:
            return True

    def is_date_visible(self, msg) -> bool:
        if not self.is_enabled():
            return True
        day = self.get_message_day(msg)
        return day is not None and day in self.visible_days

    def is_message_visible(self, msg) -> bool:
        if not msg:
            return True
        try:
            if not self.is_enabled():
                return True

            if self.is_date_object(msg):
                return self.is_date_visible(msg)

            if getattr(msg, "isDateOrUnread", False) and not self.is_date_object(msg):
                return True

            # Fast cache lookup by message id
            msg_id = None
            try:
                if hasattr(msg, "getId"):
                    msg_id = int(msg.getId())
            except Exception:
                pass

            if msg_id is not None and msg_id in self._msg_visibility_cache:
                return self._msg_visibility_cache[msg_id]

            if not self.get_show_my_messages() and self.is_outgoing_message(msg):
                visible = False
            else:
                visible = self.is_message_content_visible(msg)

            if msg_id is not None:
                self._msg_visibility_cache[msg_id] = visible

            return visible
        except Exception:
            return True

    def scan_messages_incremental(self, chat_activity, full=False):
        """Scans only new messages incrementally instead of scanning the full list on every load."""
        if not chat_activity:
            return
        try:
            messages = get_private_field(chat_activity, "messages") or getattr(chat_activity, "messages", None)
            if not messages or not hasattr(messages, "size"):
                return

            size = messages.size()
            if size == 0:
                self.visible_days.clear()
                self._scanned_message_count = 0
                return

            start_idx = 0 if full else getattr(self, "_scanned_message_count", 0)
            if start_idx >= size:
                return

            for i in range(start_idx, size):
                msg = messages.get(i)
                if not msg or self.is_date_object(msg):
                    continue
                if not self.get_show_my_messages() and self.is_outgoing_message(msg):
                    continue
                if self.is_message_visible(msg):
                    day = self.get_message_day(msg)
                    if day is not None:
                        self.visible_days.add(day)

            self._scanned_message_count = size
        except Exception as e:
            if hasattr(self, "logger") and self.logger:
                self.logger.error(f"scan_messages_incremental error: {e}")

    def on_messages_loaded(self, fragment):
        """Called when Telegram finishes loading a chunk of messages."""
        if fragment != getattr(self, "_current_fragment", None):
            return

        now = time.time()
        # Cooldown guard: prevent Telegram from loading batches in rapid succession
        if now - getattr(self, "_last_loaded_time", 0) < 0.2:
            return
        self._last_loaded_time = now

        # Only scan newly arrived messages incrementally
        self.scan_messages_incremental(fragment, full=False)

    def refresh_chat_view(self, chat_activity):
        """Forces RecyclerView / adapter to re-bind visible cells."""
        if not chat_activity:
            return
        try:
            self._msg_visibility_cache.clear()
            self.visible_days.clear()
            self._scanned_message_count = 0
            self.scan_messages_incremental(chat_activity, full=True)
            self.update_header_button_state(chat_activity)

            chat_list_view = get_private_field(chat_activity, "chatListView") or getattr(chat_activity, "chatListView", None)
            if chat_list_view is not None:
                count = chat_list_view.getChildCount()
                for i in range(count):
                    child = chat_list_view.getChildAt(i)
                    self.apply_cell_visibility(child)

                if hasattr(chat_list_view, "invalidate"):
                    chat_list_view.invalidate()

            chat_adapter = get_private_field(chat_activity, "chatAdapter") or getattr(chat_activity, "chatAdapter", None)
            if chat_adapter is not None and hasattr(chat_adapter, "notifyDataSetChanged"):
                chat_adapter.notifyDataSetChanged()
        except Exception as e:
            if hasattr(self, "logger") and self.logger:
                self.logger.error(f"refresh_chat_view error: {e}")

    def on_menu_action_click(self, context=None):
        try:
            from client_utils import get_last_fragment
            fragment = get_last_fragment()
            if fragment and "ChatActivity" in fragment.getClass().getSimpleName():
                self.open_filter_dialog(fragment)
            else:
                BulletinHelper.show_info("Open a chat to use Content Filter")
        except Exception as e:
            BulletinHelper.show_error(f"Error: {e}")

    def apply_hooks(self):
        ChatActivityClass = find_class("org.telegram.ui.ChatActivity")
        if ChatActivityClass:
            for method_name in ("createView", "onResume", "processLoadedMessages", "onFragmentDestroy"):
                try:
                    unhooks = self.hook_all_methods(ChatActivityClass, method_name, ChatActivityHook(self, method_name))
                    if unhooks:
                        self.unhook_objs.extend(unhooks)
                except Exception:
                    pass

        cell_classes = [
            find_class("org.telegram.ui.Cells.ChatMessageCell"),
            find_class("org.telegram.ui.Cells.ChatActionCell")
        ]

        cell_hook = MessageCellHook(self)
        measure_hook = MessageCellMeasureHook(self)

        for cell_cls in cell_classes:
            if not cell_cls:
                continue

            try:
                unhooks = self.hook_all_methods(cell_cls, "setMessageObject", cell_hook)
                if unhooks:
                    self.unhook_objs.extend(unhooks)
            except Exception:
                pass

            try:
                unhooks = self.hook_all_methods(cell_cls, "onMeasure", measure_hook)
                if unhooks:
                    self.unhook_objs.extend(unhooks)
            except Exception:
                pass
