            Header(text="Sender Filters"),
            Switch(
                key="show_my_messages",
                text="My Messages",
                default=True,
                subtext="Show messages sent by yourself",
                on_change=lambda val: self.set_setting("show_my_messages", val)
            ),
            Header(text="Visible Message Types"),
            Switch(
                key="show_text",
                text="Plain Text",
                default=False,
                subtext="Regular text messages",
                on_change=lambda val: self.set_setting("show_text", val)
            ),
            Switch(
                key="show_photos",
                text="Photos",
                default=True,
                subtext="Photo attachments",
                on_change=lambda val: self.set_setting("show_photos", val)
            ),
            Switch(
                key="show_videos",
                text="Videos & Video Notes",
                default=True,
                subtext="Videos and round video notes",
                on_change=lambda val: self.set_setting("show_videos", val)
            ),
            Switch(
                key="show_documents",
                text="Files & Documents",
                default=True,
                subtext="Documents, PDFs, archives, etc.",
                on_change=lambda val: self.set_setting("show_documents", val)
