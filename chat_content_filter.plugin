class LongPressRunnable(dynamic_proxy(find_class("java.lang.Runnable"))):
    def __init__(self, touch_listener, view, plugin, fragment):
        super().__init__()
        self.touch_listener = touch_listener
        self.view = view
        self.plugin = plugin
        self.fragment = fragment

    def run(self):
        if not getattr(self.touch_listener, "long_pressed", False):
            self.touch_listener.long_pressed = True
            try:
                if HapticFeedbackConstants is not None:
                    self.view.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS)
            except Exception:
                pass
            self.plugin.open_filter_dialog(self.fragment)


class ScrollSafetyRunnable(dynamic_proxy(find_class("java.lang.Runnable"))):
    """Safety runnable posted to chatListView to ensure layout pass retains exact scroll offset."""
    def __init__(self, layout_manager, pos, offset):
        super().__init__()
        self.layout_manager = layout_manager
        self.pos = pos
        self.offset = offset

    def run(self):
        try:
            if self.layout_manager and hasattr(self.layout_manager, "scrollToPositionWithOffset"):
                self.layout_manager.scrollToPositionWithOffset(self.pos, self.offset)
        except Exception:
            pass


class HeaderTouchListener(dynamic_proxy(find_class("android.view.View$OnTouchListener"))):
    """Handles short tap (toggle filter) and long press (open dialog) on the header button."""
    def __init__(self, plugin, fragment):
        super().__init__()
        self.plugin = plugin
        self.fragment = fragment
        self.long_press_runnable = None
        self.long_pressed = False
        self.timeout = DEFAULT_LONG_PRESS_TIMEOUT

    def onTouch(self, view, event):
        try:
            action = event.getAction()

            if action == MotionEvent.ACTION_DOWN:
                self.long_pressed = False
                self.long_press_runnable = LongPressRunnable(self, view, self.plugin, self.fragment)
                view.postDelayed(self.long_press_runnable, self.timeout)
                return False

            elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                if self.long_press_runnable is not None:
                    view.removeCallbacks(self.long_press_runnable)
                    self.long_press_runnable = None

                if action == MotionEvent.ACTION_UP and self.long_pressed:
                    # Long press consumed, do not trigger regular click
                    return True
        except Exception:
            pass
        return False


class ChatActivityHook(MethodHook):
    """Hooks ChatActivity lifecycle and events to attach the header button and manage message list."""
    def __init__(self, plugin, action_name):
        super().__init__()
        self.plugin = plugin
        self.action_name = action_name

    def after_hooked_method(self, param):
        try:
            fragment = param.thisObject
            if not fragment:
                return

            if self.action_name == "createView":
                run_on_ui_thread(lambda: self.plugin.attach_header_button(fragment))

            elif self.action_name == "onResume":
                run_on_ui_thread(lambda: (
                    self.plugin.attach_header_button(fragment),
                    self.plugin.update_header_button_state(fragment),
                    self.plugin.apply_filter_to_chat(fragment) if self.plugin.is_enabled() else None
                ))

            elif self.action_name == "onPause":
                if self.plugin.is_chat_filtered(fragment):
                    self.plugin.restore_original_messages(fragment)

            elif self.action_name == "onFragmentDestroy":
                self.plugin.on_chat_destroy(fragment)

            elif self.action_name == "processLoadedMessages":
                new_msgs = None
                if param.args and len(param.args) > 0:
                    first_arg = param.args[0]
                    if hasattr(first_arg, "size"):
                        new_msgs = first_arg
                self.plugin.on_messages_loaded(fragment, new_msgs)

            elif self.action_name == "didReceivedNotification":
                if self.plugin.is_enabled() and self.plugin.is_chat_filtered(fragment):
                    run_on_ui_thread(lambda: self.plugin.apply_filter_to_chat(fragment))
        except Exception:
            pass


class ChatContentFilterPlugin(BasePlugin):
    def on_plugin_load(self):
        self._loaded = True
        self.unhook_objs = []
        self._original_messages_map = {}
        self._filter_active_chats = set()
        self._msg_visibility_cache = {}
        self._last_loaded_time = 0
        self._current_fragment = None
        self._active_dialog = None

        try:
            self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    item_id="chat_content_filter_action",
                    text=self.tr("action_menu_text"),
                    subtext=self.tr("action_menu_subtext"),
                    icon="msg_filter",
                    on_click=self.on_menu_action_click
                )
            )
        except Exception:
            pass

        self.apply_hooks()
        run_on_ui_thread(lambda: BulletinHelper.show_info("Chat Content Filter loaded"))

    def on_plugin_unload(self):
        self._loaded = False
        if getattr(self, "_active_dialog", None) is not None:
            try:
                self._active_dialog.dismiss()
            except Exception:
                pass
            self._active_dialog = None
        for unhook in getattr(self, "unhook_objs", []):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self.unhook_objs.clear()

        # Restore any active filtered chats
        try:
            from client_utils import get_last_fragment
            fragment = get_last_fragment()
            if fragment and "ChatActivity" in fragment.getClass().getSimpleName():
                self.restore_original_messages(fragment)
        except Exception:
            pass

        self._original_messages_map.clear()
        self._filter_active_chats.clear()
        self._msg_visibility_cache.clear()
        self._current_fragment = None

    def on_chat_destroy(self, fragment):
        if fragment:
            self.restore_original_messages(fragment)
        if fragment == self._current_fragment:
            self._current_fragment = None

    def set_setting(self, key, value):
        super().set_setting(key, value)
        self._msg_visibility_cache.clear()

    def is_enabled(self) -> bool:
        return bool(self.get_setting("plugin_enabled", True))

    def is_chat_filtered(self, chat_activity) -> bool:
        chat_key = self._get_chat_key(chat_activity)
        return chat_key is not None and chat_key in self._filter_active_chats

    def get_show_my_messages(self) -> bool:
        """Returns True if the user's own messages should be shown."""
        val = self.get_setting("show_my_messages", None)
        if val is not None:
            return bool(val)
        old_hide = self.get_setting("hide_my_messages", None)
        if old_hide is not None:
            return not bool(old_hide)
        return True

    def get_language(self) -> str:
        lang = self.get_setting("app_language", None)
        if lang in ("en", "uk"):
            return lang
        idx = self.get_setting("language_index", None)
        if idx is not None:
            try:
                return "uk" if int(idx) == 1 else "en"
            except Exception:
                pass
        try:
            from org.telegram.messenger import LocaleController
            code = str(LocaleController.getInstance().getCurrentLocale().getLanguage()).lower()
            if code in ("uk", "ua"):
                return "uk"
        except Exception:
            pass
        return "en"

    def tr(self, key: str) -> str:
        lang = self.get_language()
        lang_dict = STRINGS.get(lang, STRINGS["en"])
        return lang_dict.get(key, STRINGS["en"].get(key, key))

    def get_category_setting(self, key: str) -> bool:
        for cat in FILTER_CATEGORIES:
            if cat["key"] == key:
                return bool(self.get_setting(key, cat["default"]))
        return bool(self.get_setting(key, False))

    def create_settings(self):
        try:
            lang = self.get_language()
            is_uk = (lang == "uk")

            settings_list = []
            if Header:
                settings_list.append(Header(text=self.tr("settings_desc_title")))
            if Divider:
                settings_list.append(Divider(text=self.tr("settings_desc_body")))
            if Header:
                settings_list.append(Header(text=self.tr("settings_lang_header")))

            used_selector = False
            if Selector is not None:
                try:
                    lang_idx = 1 if is_uk else 0
                    settings_list.append(
                        Selector(
                            key="language_index",
                            text=self.tr("settings_lang_title"),
                            default=lang_idx,
                            items=["English", "Українська"],
                            on_change=lambda val: (
                                self.set_setting("language_index", int(val)),
                                self.set_setting("app_language", "uk" if int(val) == 1 else "en")
                            )
                        )
                    )
                    used_selector = True
                except Exception:
                    used_selector = False

            if not used_selector and Switch is not None:
                settings_list.append(
                    Switch(
                        key="lang_uk_active",
                        text="Українська мова",
                        default=is_uk,
                        subtext="Увімкнено: Українська · Off: English",
                        on_change=lambda val: (
                            self.set_setting("app_language", "uk" if val else "en"),
                            self.set_setting("language_index", 1 if val else 0)
                        )
                    )
                )

            if Divider:
                settings_list.append(Divider())

            return settings_list
        except Exception as e:
            if hasattr(self, "logger") and self.logger:
                self.logger.error(f"create_settings error: {e}")
            return []

    def create_vector_drawable(self, activity, path_data, color=None, size_dp=24):
        """Creates a vector BitmapDrawable using the given SVG path and color."""
        try:
            try:
                from androidx.core.graphics import PathParser
            except Exception:
                try:
                    from android.util import PathParser
                except Exception:
                    PathParser = None

            if not PathParser:
                return None

            from android.graphics import Bitmap, Canvas, Paint, Matrix
            from android.graphics.drawable import BitmapDrawable
            from org.telegram.ui.ActionBar import Theme

            size_px = AndroidUtilities.dp(size_dp) if AndroidUtilities else (size_dp * 3)
            if size_px <= 0:
                size_px = size_dp * 3

            path = PathParser.createPathFromPathData(path_data)
            if not path:
                return None

            scale = float(size_px) / 24.0
            matrix = Matrix()
            matrix.setScale(scale, scale)
            path.transform(matrix)

            bitmap = Bitmap.createBitmap(size_px, size_px, Bitmap.Config.ARGB_8888)
            canvas = Canvas(bitmap)

            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            if color is None:
                color = 0xFFE3E3E3
                try:
                    if hasattr(Theme, "key_actionBarDefaultIcon"):
                        color = Theme.getColor(Theme.key_actionBarDefaultIcon)
                except Exception:
                    pass

            paint.setColor(color)
            paint.setStyle(Paint.Style.FILL)
            canvas.drawPath(path, paint)

            res = activity.getResources() if activity else None
            return BitmapDrawable(res, bitmap)
        except Exception as e:
            if hasattr(self, "logger") and self.logger:
                self.logger.error(f"create_vector_drawable error: {e}")
            return None

    def create_eye_drawable(self, activity, is_visible, color=None, size_dp=24):
        """Returns Open Eye if is_visible is True, or Crossed-out Eye if False."""
        path_data = PATH_VISIBILITY_ON if is_visible else PATH_VISIBILITY_OFF
        return self.create_vector_drawable(activity, path_data, color=color, size_dp=size_dp)

    def find_filter_icon_id(self, activity):
        try:
            from org.telegram.messenger import R
            for field in dir(R.drawable):
                field_lower = field.lower()
                if "filter" in field_lower or "msg_filter" in field_lower:
                    icon_id = int(getattr(R.drawable, field, 0))
                    if icon_id > 0:
                        return icon_id
        except Exception:
            pass

        if activity:
            try:
                pkg = str(activity.getPackageName())
                res = activity.getResources()
                for name in ("ic_ab_filter", "ic_filter", "filter", "msg_filter", "ic_bar_filter", "msg_customize", "msg_list"):
                    icon_id = int(res.getIdentifier(name, "drawable", pkg))
                    if icon_id > 0:
                        return icon_id
            except Exception:
                pass

        try:
            from org.telegram.messenger import R
            return int(getattr(R.drawable, "msg_list", 0))
        except Exception:
            return 0

    def update_header_button_state(self, fragment):
        """Updates header button icon: Open Eye when filter is active, Crossed Eye when inactive."""
        if not fragment:
            return
        try:
            bar = fragment.getActionBar()
            if not bar:
                return
            menu = bar.createMenu()
            if not menu:
                return
            item = menu.getItem(FILTER_HEADER_ID)
            if not item:
                return

            activity = fragment.getParentActivity()
            is_enabled = self.is_enabled()
            path_data = PATH_VISIBILITY_ON if is_enabled else PATH_VISIBILITY_OFF
            drawable = self.create_vector_drawable(activity, path_data, size_dp=24)
            if drawable and hasattr(item, "setIcon"):
                item.setIcon(drawable)
            item.setAlpha(1.0 if is_enabled else 0.6)
        except Exception:
            pass

    def attach_header_button(self, fragment):
        if not self._loaded or not fragment:
            return
        try:
            bar = fragment.getActionBar()
            if not bar:
                return
            menu = bar.createMenu()
            if not menu:
                return

            if fragment != getattr(self, "_current_fragment", None):
                self._current_fragment = fragment
                self._msg_visibility_cache.clear()

            item = menu.getItem(FILTER_HEADER_ID)
            if item is not None:
                self.update_header_button_state(fragment)
                return

            activity = fragment.getParentActivity()
            is_enabled = self.is_enabled()
            path_data = PATH_VISIBILITY_ON if is_enabled else PATH_VISIBILITY_OFF
            drawable = self.create_vector_drawable(activity, path_data, size_dp=24)
            fallback_icon = self.find_filter_icon_id(activity) or 0

            width_dp = AndroidUtilities.dp(48) if AndroidUtilities else 144
            item = menu.addItemWithWidth(FILTER_HEADER_ID, fallback_icon, width_dp, self.tr("master_title"))
            if item and drawable:
                try:
                    item.setIcon(drawable)
                except Exception:
                    pass

            if item:
                try:
                    count = menu.getChildCount()
                    if count > 1:
                        menu.removeView(item)
                        menu.addView(item, count - 2)
                except Exception:
                    pass

                plugin_self = self
                touch_listener = HeaderTouchListener(plugin_self, fragment)
                item.setOnTouchListener(touch_listener)

                def handle_short_click(view):
                    if getattr(touch_listener, "long_pressed", False):
                        touch_listener.long_pressed = False
                        return
                    new_state = not plugin_self.is_enabled()
                    plugin_self.set_setting("plugin_enabled", new_state)
                    plugin_self.update_header_button_state(fragment)

                    if new_state:
                        plugin_self.apply_filter_to_chat(fragment)
                        BulletinHelper.show_info(plugin_self.tr("filter_enabled_info"))
                    else:
                        plugin_self.restore_original_messages(fragment)
                        BulletinHelper.show_info(plugin_self.tr("filter_disabled_info"))

                item.setOnClickListener(OnClickListener(handle_short_click))

                def handle_long_click(view):
                    if not getattr(touch_listener, "long_pressed", False):
                        touch_listener.long_pressed = True
                        plugin_self.open_filter_dialog(fragment)
                    return True

                item.setLongClickable(True)
                item.setOnLongClickListener(OnLongClickListener(handle_long_click))

                self.update_header_button_state(fragment)
        except Exception as e:
            if hasattr(self, "logger") and self.logger:
                self.logger.error(f"attach_header_button error: {e}")

    def open_filter_dialog(self, fragment):
        """Opens options dialog where toggles are represented by Eye icons."""
        activity = fragment.getParentActivity() if fragment else None
        if not activity:
            return

        # Prevent duplicate dialogs from opening simultaneously
        current_dialog = getattr(self, "_active_dialog", None)
        if current_dialog is not None:
            try:
                if hasattr(current_dialog, "isShowing") and current_dialog.isShowing():
                    return
            except Exception:
                pass
            self._active_dialog = None

        text_color = 0xFFFFFFFF
        subtext_color = 0xFFAAAAAA
        divider_color = 0x22888888
        accent_color = 0xFF50A7EA
        card_bg = 0x18FFFFFF

        try:
            from org.telegram.ui.ActionBar import Theme
            if hasattr(Theme, "key_dialogTextBlack"):
                text_color = Theme.getColor(Theme.key_dialogTextBlack)
            elif hasattr(Theme, "key_windowBackgroundWhiteBlackText"):
                text_color = Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)

            if hasattr(Theme, "key_dialogTextGray"):
                subtext_color = Theme.getColor(Theme.key_dialogTextGray)
            elif hasattr(Theme, "key_windowBackgroundWhiteGrayText"):
                subtext_color = Theme.getColor(Theme.key_windowBackgroundWhiteGrayText)

            if hasattr(Theme, "key_divider"):
                divider_color = Theme.getColor(Theme.key_divider)

            if hasattr(Theme, "key_windowBackgroundWhiteBlueHeader"):
                accent_color = Theme.getColor(Theme.key_windowBackgroundWhiteBlueHeader)
            elif hasattr(Theme, "key_dialogButton"):
                accent_color = Theme.getColor(Theme.key_dialogButton)

            if hasattr(Theme, "key_dialogBackground"):
                card_bg = (Theme.getColor(Theme.key_dialogBackground) & 0x00FFFFFF) | 0x1F000000
        except Exception:
            pass

        builder = AlertDialogBuilder(activity)
        builder.set_title(self.tr("dialog_title"))

        container = LinearLayout(activity)
        container.setOrientation(LinearLayout.VERTICAL)
        pad = AndroidUtilities.dp(16) if AndroidUtilities else 48
        container.setPadding(pad, pad, pad, pad)

        plugin_self = self

        def perform_haptic(v):
            try:
                if HapticFeedbackConstants is not None and v:
                    v.performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP)
            except Exception:
                pass

        # 1. Master Toggle Card (Larger Eye Icon)
        master_card = LinearLayout(activity)
        master_card.setOrientation(LinearLayout.HORIZONTAL)
        m_pad = AndroidUtilities.dp(14) if AndroidUtilities else 42
        master_card.setPadding(m_pad, m_pad, m_pad, m_pad)

        card_drawable = GradientDrawable()
        card_radius = float(AndroidUtilities.dp(12)) if AndroidUtilities else 36.0
        card_drawable.setCornerRadius(card_radius)
        card_drawable.setColor(card_bg)
        stroke_w = AndroidUtilities.dp(1) if AndroidUtilities else 2
        card_drawable.setStroke(stroke_w, divider_color)
        master_card.setBackground(card_drawable)

        master_text_box = LinearLayout(activity)
        master_text_box.setOrientation(LinearLayout.VERTICAL)
        master_text_box.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1.0))

        master_label = TextView(activity)
        master_label.setText(self.tr("master_title"))
        master_label.setTextSize(2, 16)
        master_label.setTextColor(text_color)
        try:
            if AndroidUtilities:
                master_label.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
        except Exception:
            pass

        master_sub = TextView(activity)
        master_sub.setText(self.tr("master_sub"))
        master_sub.setTextSize(2, 12)
        master_sub.setTextColor(subtext_color)
        sub_pad = AndroidUtilities.dp(2) if AndroidUtilities else 4
        master_sub.setPadding(0, sub_pad, 0, 0)

        master_text_box.addView(master_label)
        master_text_box.addView(master_sub)

        # Master Eye: Prominent 34dp icon
        master_eye = ImageView(activity)
        eye_master_sz = AndroidUtilities.dp(34) if AndroidUtilities else 102
        master_eye.setLayoutParams(LinearLayout.LayoutParams(eye_master_sz, eye_master_sz))

        master_card.addView(master_text_box)
        master_card.addView(master_eye)
        container.addView(master_card)

        # 2. Subordinate Categories Container (will be dimmed when master is OFF)
        categories_container = LinearLayout(activity)
        categories_container.setOrientation(LinearLayout.VERTICAL)

        def refresh_master_ui(is_on):
            m_color = accent_color if is_on else subtext_color
            d = plugin_self.create_eye_drawable(activity, is_on, color=m_color, size_dp=34)
            if d:
                master_eye.setImageDrawable(d)
            master_eye.setAlpha(1.0 if is_on else 0.5)
            # When master is OFF, subordinate items become dimmed (alpha = 0.38)
            categories_container.setAlpha(1.0 if is_on else 0.38)

        def on_master_click(view):
            perform_haptic(master_card)
            new_on = not plugin_self.is_enabled()
            plugin_self.set_setting("plugin_enabled", new_on)
            refresh_master_ui(new_on)
            plugin_self.update_header_button_state(fragment)
            if fragment:
                if new_on:
                    plugin_self.apply_filter_to_chat(fragment)
                else:
                    plugin_self.restore_original_messages(fragment)

        master_card.setOnClickListener(OnClickListener(on_master_click))
        refresh_master_ui(plugin_self.is_enabled())

        def add_section_header(title):
            header = TextView(activity)
            header.setText(title)
            header.setTextSize(2, 12)
            header.setTextColor(accent_color)
            top_pad = AndroidUtilities.dp(16) if AndroidUtilities else 48
            bot_pad = AndroidUtilities.dp(6) if AndroidUtilities else 18
            header.setPadding(0, top_pad, 0, bot_pad)
            try:
                if AndroidUtilities:
                    header.setTypeface(AndroidUtilities.getTypeface("fonts/rmedium.ttf"))
            except Exception:
                pass
            categories_container.addView(header)

        def add_divider():
            div = View(activity)
            line_h = AndroidUtilities.dp(1) if AndroidUtilities else 2
            lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, line_h)
            m_top = AndroidUtilities.dp(12) if AndroidUtilities else 36
            m_bot = AndroidUtilities.dp(4) if AndroidUtilities else 12
            lp.setMargins(0, m_top, 0, m_bot)
            div.setLayoutParams(lp)
            div.setBackgroundColor(divider_color)
            categories_container.addView(div)

        def add_eye_row(key, title, subtitle, default_val):
            row = LinearLayout(activity)
            row.setOrientation(LinearLayout.HORIZONTAL)
            r_pad = AndroidUtilities.dp(10) if AndroidUtilities else 30
            h_pad = AndroidUtilities.dp(4) if AndroidUtilities else 12
            row.setPadding(h_pad, r_pad, h_pad, r_pad)

            text_box = LinearLayout(activity)
            text_box.setOrientation(LinearLayout.VERTICAL)
            text_box.setLayoutParams(LinearLayout.LayoutParams(0, -2, 1.0))

            label = TextView(activity)
            label.setText(title)
            label.setTextSize(2, 15)
            label.setTextColor(text_color)

            sub = TextView(activity)
            sub.setText(subtitle)
            sub.setTextSize(2, 12)
            sub.setTextColor(subtext_color)
            sub.setPadding(0, AndroidUtilities.dp(2) if AndroidUtilities else 6, 0, 0)

            text_box.addView(label)
            text_box.addView(sub)

            # Category Eye: 24dp standard icon
            eye_view = ImageView(activity)
            eye_sz = AndroidUtilities.dp(24) if AndroidUtilities else 72
            eye_view.setLayoutParams(LinearLayout.LayoutParams(eye_sz, eye_sz))

            def refresh_row_eye(is_vis):
                row_color = accent_color if is_vis else subtext_color
                d = plugin_self.create_eye_drawable(activity, is_vis, color=row_color, size_dp=24)
                if d:
                    eye_view.setImageDrawable(d)
                eye_view.setAlpha(1.0 if is_vis else 0.45)

            current_val = plugin_self.get_show_my_messages() if key == "show_my_messages" else bool(plugin_self.get_category_setting(key))
            refresh_row_eye(current_val)

            def on_row_click(view):
                perform_haptic(row)
                # If master toggle is currently off, tapping a subordinate item enables master
                if not plugin_self.is_enabled():
                    plugin_self.set_setting("plugin_enabled", True)
                    refresh_master_ui(True)
                    plugin_self.update_header_button_state(fragment)

                curr = plugin_self.get_show_my_messages() if key == "show_my_messages" else bool(plugin_self.get_category_setting(key))
                new_val = not curr
                plugin_self.set_setting(key, new_val)
                refresh_row_eye(new_val)

                if fragment and plugin_self.is_enabled():
                    plugin_self.apply_filter_to_chat(fragment)

            row.setOnClickListener(OnClickListener(on_row_click))

            row.addView(text_box)
            row.addView(eye_view)
            categories_container.addView(row)

        lang = self.get_language()

        # 3. Sender Filters Section
        add_divider()
        add_section_header(self.tr("sec_sender"))
        for cat in FILTER_CATEGORIES:
            if cat["section"] == "SENDER":
                c_title = cat["title"].get(lang, cat["title"]["en"])
                c_sub = cat["subtitle"].get(lang, cat["subtitle"]["en"])
                add_eye_row(cat["key"], c_title, c_sub, cat["default"])

        # 4. Content Categories Section
        add_divider()
        add_section_header(self.tr("sec_content"))
        for cat in FILTER_CATEGORIES:
            if cat["section"] == "CONTENT":
                c_title = cat["title"].get(lang, cat["title"]["en"])
                c_sub = cat["subtitle"].get(lang, cat["subtitle"]["en"])
                add_eye_row(cat["key"], c_title, c_sub, cat["default"])

        container.addView(categories_container)

        scroll = ScrollView(activity)
        scroll.addView(container)

        builder.set_view(scroll)

        def on_dialog_dismissed():
            plugin_self._active_dialog = None
            plugin_self.update_header_button_state(fragment)

        builder.set_positive_button(self.tr("btn_done"), lambda dialog, which: (
            dialog.dismiss(),
            on_dialog_dismissed()
        ))

        dialog = builder.show()
        self._active_dialog = dialog

        if DialogDismissProxy and dialog:
            try:
                dialog.setOnDismissListener(DialogDismissProxy(lambda d: on_dialog_dismissed()))
            except Exception:
                pass

    def _get_chat_key(self, chat_activity):
        if not chat_activity:
            return None
        try:
            return int(chat_activity.getDialogId())
        except Exception:
            return id(chat_activity)

    def _get_msg_key(self, msg):
        if not msg:
            return None
        try:
            if hasattr(msg, "getId"):
                mid = int(msg.getId())
                if mid != 0:
                    return mid
        except Exception:
            pass
        return id(msg)

    def is_date_object(self, msg) -> bool:
        if not msg:
            return False
        try:
            if getattr(msg, "type", -1) == 10:
                return True
            if getattr(msg, "isDateObject", False):
                return True
            if getattr(msg, "contentType", -1) == 1:
                return True
            raw = getattr(msg, "messageOwner", msg)
            action = getattr(raw, "action", None)
            if action is not None:
                cname = action.getClass().getSimpleName()
                if "Date" in cname:
                    return True
        except Exception:
            pass
        return False

    def is_outgoing_message(self, msg) -> bool:
        if not msg:
            return False
        try:
            if hasattr(msg, "isOut") and callable(msg.isOut):
                return bool(msg.isOut())
            elif hasattr(msg, "isOut") and isinstance(msg.isOut, bool):
                return bool(msg.isOut)
            if hasattr(msg, "isOutOwner") and callable(msg.isOutOwner):
                return bool(msg.isOutOwner())
            raw = getattr(msg, "messageOwner", msg)
            if getattr(raw, "out", False):
                return True
        except Exception:
            pass
        return False

    def get_message_day(self, msg):
        if not msg:
            return None
        try:
            raw = getattr(msg, "messageOwner", msg)
            ts = getattr(raw, "date", None)
            if ts is None:
                ts = getattr(msg, "date", None)
            if ts:
                return int(ts) // 86400
        except Exception:
            pass
        return None

    def is_message_content_visible(self, msg) -> bool:
        if not msg:
            return True
        try:
            raw = getattr(msg, "messageOwner", msg)

            if getattr(raw, "action", None) is not None:
                return self.get_category_setting("show_calls")

            media = getattr(raw, "media", None)
            media_type = media.getClass().getSimpleName() if media else "None"

            if (hasattr(msg, "isPoll") and msg.isPoll()) or media_type == "TL_messageMediaPoll":
                return self.get_category_setting("show_polls")

            if (hasattr(msg, "isSticker") and msg.isSticker()) or \
               (hasattr(msg, "isGif") and msg.isGif()) or \
               (hasattr(msg, "isAnimatedSticker") and msg.isAnimatedSticker()):
                return self.get_category_setting("show_stickers")

            if (hasattr(msg, "isVoice") and msg.isVoice()) or \
               (hasattr(msg, "isMusic") and msg.isMusic()) or \
               (hasattr(msg, "isAudio") and msg.isAudio()):
                return self.get_category_setting("show_audio")

            if (hasattr(msg, "isVideo") and msg.isVideo()) or \
               (hasattr(msg, "isRoundVideo") and msg.isRoundVideo()):
                return self.get_category_setting("show_videos")

            if (hasattr(msg, "isPhoto") and msg.isPhoto()) or media_type == "TL_messageMediaPhoto":
                return self.get_category_setting("show_photos")

            if (hasattr(msg, "isDocument") and msg.isDocument()) or media_type == "TL_messageMediaDocument":
                return self.get_category_setting("show_documents")

            if media_type == "TL_messageMediaWebPage" or (hasattr(msg, "hasWebPage") and msg.hasWebPage()):
                return self.get_category_setting("show_links")

            has_url = False
            try:
                entities = getattr(raw, "entities", None)
                if entities is not None:
                    for e in entities:
                        cname = e.getClass().getSimpleName()
                        if "Url" in cname or "URL" in cname:
                            has_url = True
                            break
            except Exception:
                pass

            if has_url:
                return self.get_category_setting("show_links")

            if media is not None and media_type not in ("TL_messageMediaEmpty", "None"):
                return self.get_category_setting("show_calls")

            return self.get_category_setting("show_text")

        except Exception:
            return True

    def is_message_visible(self, msg) -> bool:
        if not msg:
            return True
        try:
            if not self.is_enabled():
                return True

            if self.is_date_object(msg):
                return True

            msg_id = None
            try:
                if hasattr(msg, "getId"):
                    msg_id = int(msg.getId())
            except Exception:
                pass

            if msg_id is not None and msg_id in self._msg_visibility_cache:
                return self._msg_visibility_cache[msg_id]

            if not self.get_show_my_messages() and self.is_outgoing_message(msg):
                visible = False
            else:
                visible = self.is_message_content_visible(msg)

            if msg_id is not None:
                self._msg_visibility_cache[msg_id] = visible

            return visible
        except Exception:
            return True

    def _get_scroll_anchor(self, chat_activity):
        """Finds the message closest to the vertical center of the chat list, along with its pixel offset."""
        try:
            chat_list_view = get_private_field(chat_activity, "chatListView") or getattr(chat_activity, "chatListView", None)
            chat_layout_manager = get_private_field(chat_activity, "chatLayoutManager") or getattr(chat_activity, "chatLayoutManager", None)
            if not chat_list_view or not chat_layout_manager:
                return None

            count = chat_list_view.getChildCount()
            if count == 0:
                return None

            view_height = chat_list_view.getHeight()
            center_y = view_height / 2.0

            is_reverse = False
            try:
                if hasattr(chat_layout_manager, "getReverseLayout"):
                    is_reverse = bool(chat_layout_manager.getReverseLayout())
            except Exception:
                pass

            best_msg = None
            best_id = None
            best_offset = 0
            best_dist = float("inf")
            best_adapter_pos = -1

            for i in range(count):
                child = chat_list_view.getChildAt(i)
                if not child:
                    continue

                msg = None
                if hasattr(child, "getMessageObject"):
                    msg = child.getMessageObject()
                elif hasattr(child, "currentMessageObject"):
                    msg = getattr(child, "currentMessageObject", None)

                pos = -1
                if hasattr(chat_list_view, "getChildAdapterPosition"):
                    pos = chat_list_view.getChildAdapterPosition(child)
                elif hasattr(chat_list_view, "getChildPosition"):
                    pos = chat_list_view.getChildPosition(child)

                if not msg and pos >= 0:
                    messages = get_private_field(chat_activity, "messages") or getattr(chat_activity, "messages", None)
                    if messages and pos < messages.size():
                        msg = messages.get(pos)

                if not msg:
                    continue

                mid = None
                try:
                    if hasattr(msg, "getId"):
                        mid = int(msg.getId())
                except Exception:
                    pass

                child_top = child.getTop()
                child_bottom = child.getBottom()
                child_center = (child_top + child_bottom) / 2.0
                dist = abs(child_center - center_y)

                # Prioritize actual content messages over date dividers
                if self.is_date_object(msg):
                    dist += 1000.0

                if dist < best_dist:
                    best_dist = dist
                    best_msg = msg
                    best_id = mid
                    best_adapter_pos = pos

                    if is_reverse:
                        pad_bottom = chat_list_view.getPaddingBottom() if hasattr(chat_list_view, "getPaddingBottom") else 0
                        best_offset = view_height - child_bottom - pad_bottom
                    else:
                        pad_top = chat_list_view.getPaddingTop() if hasattr(chat_list_view, "getPaddingTop") else 0
                        best_offset = child_top - pad_top

            adapter_offset = 0
            if best_msg and best_id is not None and best_adapter_pos >= 0:
                messages = get_private_field(chat_activity, "messages") or getattr(chat_activity, "messages", None)
                if messages:
                    for idx in range(messages.size()):
                        m = messages.get(idx)
                        m_id = None
                        try:
                            if hasattr(m, "getId"):
                                m_id = int(m.getId())
                        except Exception:
                            pass
                        if m_id == best_id:
                            adapter_offset = best_adapter_pos - idx
                            break

            if best_msg and best_id is not None:
                return {
                    "id": best_id,
                    "msg": best_msg,
                    "offset": int(best_offset),
                    "adapter_offset": adapter_offset,
                }
        except Exception:
            pass
        return None

    def _restore_scroll_anchor(self, chat_activity, anchor):
        """Restores the chat scroll position using scrollToPositionWithOffset on the layout manager."""
        if not anchor or not chat_activity:
            return
        try:
            messages = get_private_field(chat_activity, "messages") or getattr(chat_activity, "messages", None)
            chat_layout_manager = get_private_field(chat_activity, "chatLayoutManager") or getattr(chat_activity, "chatLayoutManager", None)
            chat_list_view = get_private_field(chat_activity, "chatListView") or getattr(chat_activity, "chatListView", None)
            if not messages or not chat_layout_manager or messages.size() == 0:
                return

            target_id = anchor.get("id")
            target_offset = anchor.get("offset", 0)
            target_idx = -1

            if target_id is not None:
                for i in range(messages.size()):
                    m = messages.get(i)
                    mid = None
                    try:
                        if hasattr(m, "getId"):
                            mid = int(m.getId())
                    except Exception:
                        pass
                    if mid == target_id:
                        target_idx = i
                        break

            # If exact message not found (e.g. filtered out when enabling filter), find nearest message by date
            if target_idx == -1 and anchor.get("msg"):
                orig_msg = anchor["msg"]
                raw_orig = getattr(orig_msg, "messageOwner", orig_msg)
                orig_date = getattr(raw_orig, "date", None) or getattr(orig_msg, "date", 0)
                best_diff = float("inf")
                for i in range(messages.size()):
                    m = messages.get(i)
                    raw_m = getattr(m, "messageOwner", m)
                    m_date = getattr(raw_m, "date", None) or getattr(m, "date", 0)
                    diff = abs(int(m_date) - int(orig_date))
                    if diff < best_diff:
                        best_diff = diff
                        target_idx = i

            if target_idx == -1:
                return

            final_pos = target_idx + anchor.get("adapter_offset", 0)
            if final_pos < 0:
                final_pos = 0

            if hasattr(chat_layout_manager, "scrollToPositionWithOffset"):
                chat_layout_manager.scrollToPositionWithOffset(final_pos, target_offset)

                if chat_list_view:
                    chat_list_view.post(ScrollSafetyRunnable(chat_layout_manager, final_pos, target_offset))
        except Exception:
            pass

    def apply_filter_to_chat(self, chat_activity):
        """Applies data-level filtering by placing only matching messages into ChatActivity.messages."""
        if not chat_activity or not self._loaded:
            return

        chat_key = self._get_chat_key(chat_activity)
        if chat_key is None:
            return

        messages = get_private_field(chat_activity, "messages") or getattr(chat_activity, "messages", None)
        if messages is None:
            return

        chat_adapter = get_private_field(chat_activity, "chatAdapter") or getattr(chat_activity, "chatAdapter", None)

        if not self.is_enabled():
            self.restore_original_messages(chat_activity)
            return

        anchor = self._get_scroll_anchor(chat_activity)

        # Initialize or merge snapshot of original messages
        orig = self._original_messages_map.get(chat_key)
        if orig is None:
            orig = []
            for i in range(messages.size()):
                orig.append(messages.get(i))
            self._original_messages_map[chat_key] = orig
        else:
            # Sync any new incoming messages that Telegram placed into messages
            known_keys = {self._get_msg_key(m) for m in orig}
            new_top = []
            new_bottom = []
            for i in range(messages.size()):
                m = messages.get(i)
                m_key = self._get_msg_key(m)
                if m_key not in known_keys:
                    known_keys.add(m_key)
                    if i == 0:
                        new_top.append(m)
                    else:
                        new_bottom.append(m)
            if new_top:
                orig[0:0] = new_top
            if new_bottom:
                orig.extend(new_bottom)

        # Detect days that have at least one visible content message
        visible_days = set()
        for msg in orig:
            if not self.is_date_object(msg) and self.is_message_visible(msg):
                day = self.get_message_day(msg)
                if day is not None:
                    visible_days.add(day)

        filtered = []
        for msg in orig:
            if self.is_date_object(msg):
                day = self.get_message_day(msg)
                if day is not None and day in visible_days:
                    filtered.append(msg)
            else:
                if self.is_message_visible(msg):
                    filtered.append(msg)

        # Populate the Java ArrayList in-place
        messages.clear()
        for msg in filtered:
            messages.add(msg)

        self._filter_active_chats.add(chat_key)

        if chat_adapter is not None and hasattr(chat_adapter, "notifyDataSetChanged"):
            chat_adapter.notifyDataSetChanged()

        self._restore_scroll_anchor(chat_activity, anchor)

    def restore_original_messages(self, chat_activity):
        """Restores the complete, unfiltered messages list into ChatActivity.messages."""
        if not chat_activity:
            return

        chat_key = self._get_chat_key(chat_activity)
        if chat_key is None:
            return

        orig = self._original_messages_map.get(chat_key)
        messages = get_private_field(chat_activity, "messages") or getattr(chat_activity, "messages", None)

        anchor = self._get_scroll_anchor(chat_activity)

        if messages is not None and orig is not None:
            messages.clear()
            for msg in orig:
                messages.add(msg)

        if chat_key in self._filter_active_chats:
            self._filter_active_chats.remove(chat_key)
        if chat_key in self._original_messages_map:
            del self._original_messages_map[chat_key]

        chat_adapter = get_private_field(chat_activity, "chatAdapter") or getattr(chat_activity, "chatAdapter", None)
        if chat_adapter is not None and hasattr(chat_adapter, "notifyDataSetChanged"):
            chat_adapter.notifyDataSetChanged()

        self._restore_scroll_anchor(chat_activity, anchor)

    def on_messages_loaded(self, fragment, new_messages_arg=None):
        """Called when Telegram loads an older chunk of messages via pagination."""
        if not fragment or not self.is_enabled():
            return

        chat_key = self._get_chat_key(fragment)
        if chat_key not in self._filter_active_chats:
            return

        now = time.time()
        # Cooldown guard: prevent excessive rapid execution
        if now - getattr(self, "_last_loaded_time", 0) < 0.15:
            return
        self._last_loaded_time = now

        orig = self._original_messages_map.get(chat_key)
        if orig is None:
            return

        known_keys = {self._get_msg_key(m) for m in orig}

        # If new messages list was passed directly in hook arguments
        if new_messages_arg is not None and hasattr(new_messages_arg, "size"):
            for i in range(new_messages_arg.size()):
                m = new_messages_arg.get(i)
                m_key = self._get_msg_key(m)
                if m_key not in known_keys:
                    known_keys.add(m_key)
                    orig.append(m)

        # Re-apply filter on UI thread
        run_on_ui_thread(lambda: self.apply_filter_to_chat(fragment))

    def on_menu_action_click(self, context=None):
        try:
            from client_utils import get_last_fragment
            fragment = get_last_fragment()
            if fragment and "ChatActivity" in fragment.getClass().getSimpleName():
                self.open_filter_dialog(fragment)
            else:
                BulletinHelper.show_info("Open a chat to use Content Filter")
        except Exception as e:
            BulletinHelper.show_error(f"Error: {e}")

    def apply_hooks(self):
        ChatActivityClass = find_class("org.telegram.ui.ChatActivity")
        if ChatActivityClass:
            for method_name in ("createView", "onResume", "onPause", "onFragmentDestroy", "processLoadedMessages", "didReceivedNotification"):
                try:
                    unhooks = self.hook_all_methods(ChatActivityClass, method_name, ChatActivityHook(self, method_name))
                    if unhooks:
                        self.unhook_objs.extend(unhooks)
                except Exception:
                    pass
