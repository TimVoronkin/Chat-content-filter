            Header(text="Visible Message Types"),
            Switch(
                key="show_text",
                text="Plain Text Messages",
                default=False,
                subtext="Show regular text messages",
                on_change=lambda val: self.set_setting("show_text", val)
            ),
            Switch(
                key="show_photos",
                text="Photos",
                default=True,
                subtext="Show photo attachments",
                on_change=lambda val: self.set_setting("show_photos", val)
            ),
            Switch(
                key="show_videos",
                text="Videos & Video Notes",
                default=True,
                subtext="Show videos and video messages",
                on_change=lambda val: self.set_setting("show_videos", val)
            ),
            Switch(
                key="show_documents",
                text="Files & Documents",
                default=True,
                subtext="Show documents, PDFs, archives, etc.",
                on_change=lambda val: self.set_setting("show_documents", val)
            ),
            Switch(
                key="show_audio",
                text="Voice Notes & Music",
                default=False,
                subtext="Show voice messages and audio files",
