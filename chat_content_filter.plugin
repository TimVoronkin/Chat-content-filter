from java import dynamic_proxy
from android.widget import CompoundButton, LinearLayout, ScrollView, TextView, Switch as AndroidSwitch
from android.view import View

try:
    from android_utils import OnLongClickListener
except Exception:
    class OnLongClickListener(dynamic_proxy(View.OnLongClickListener)):
        def __init__(self, callback):
            super().__init__()
            self.callback = callback

        def onLongClick(self, view):
            try:
                return bool(self.callback(view))
            except Exception:
                return True

__id__ = "chat_content_filter"
__name__ = "Chat Content Filter"
__description__ = "Filter specific message types in chats with a header button and interactive toggles."
__author__ = "Personal edition"
__version__ = "4.2.0"
__icon__ = "exteraPlugins/1"
__min_version__ = "12.5.1"
__sdk_version__ = ">=1.4.3.3"

FILTER_HEADER_ID = 850099


def _set_zero_dimensions(view):
    """Safely call setMeasuredDimension(0, 0) to avoid IllegalStateException."""
    try:
        view.setMeasuredDimension(0, 0)
        return True
    except Exception:
        pass
    try:
        from java.lang import Integer
        int_type = Integer.TYPE
        ViewClass = find_class("android.view.View")
        method = ViewClass.getDeclaredMethod("setMeasuredDimension", [int_type, int_type])
        method.setAccessible(True)
        method.invoke(view, 0, 0)
        return True
    except Exception:
        return False


class SwitchChangeListener(dynamic_proxy(CompoundButton.OnCheckedChangeListener)):
    def __init__(self, key, plugin, fragment):
        super().__init__()
        self.key = key
        self.plugin = plugin
        self.fragment = fragment

    def onCheckedChanged(self, buttonView, isChecked):
        self.plugin.set_setting(self.key, isChecked)
        if self.fragment:
            run_on_ui_thread(lambda: self.plugin.refresh_chat_view(self.fragment))


class ChatActivityHook(MethodHook):
    def __init__(self, plugin, action_name):
        super().__init__()
        self.plugin = plugin
        self.action_name = action_name

    def after_hooked_method(self, param):
        try:
            fragment = param.thisObject
            if not fragment:
                return

            if self.action_name in ("createView", "onResume"):
                run_on_ui_thread(lambda: self.plugin.attach_header_button(fragment))

            if self.action_name in ("onResume", "processLoadedMessages"):
                self.plugin.update_visible_dates(fragment)
                if self.action_name == "onResume":
                    run_on_ui_thread(lambda: self.plugin.refresh_chat_view(fragment))
        except Exception:
            pass


class MessageCellHook(MethodHook):
    """Hooks setMessageObject on ChatMessageCell and ChatActionCell to adjust visibility."""
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            cell = param.thisObject
            if not cell:
                return

            self.plugin.apply_cell_visibility(cell)
        except Exception:
            pass


class MessageCellMeasureHook(MethodHook):
    """Hooks onMeasure on ChatMessageCell and ChatActionCell to collapse hidden rows to 0x0."""
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if not self.plugin.get_setting("plugin_enabled", True):
                return

            cell = param.thisObject
            if not cell:
                return

            if cell.getVisibility() == View.GONE:
                if _set_zero_dimensions(cell):
                    param.setResult(None)
                return

            msg = self.plugin.get_cell_message_object(cell)
            if msg is not None and not self.plugin.is_message_visible(msg):
                cell.setVisibility(View.GONE)
                lp = cell.getLayoutParams()
                if lp is not None:
                    lp.width = 0
                    lp.height = 0
                if _set_zero_dimensions(cell):
                    param.setResult(None)
        except Exception:
            pass


class MessageCellDrawHook(MethodHook):
    """Hooks onDraw on ChatMessageCell and ChatActionCell to prevent drawing hidden items."""
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if not self.plugin.get_setting("plugin_enabled", True):
                return

            cell = param.thisObject
            if not cell:
                return

            if cell.getVisibility() == View.GONE:
                param.setResult(None)
                return

            msg = self.plugin.get_cell_message_object(cell)
            if msg is not None and not self.plugin.is_message_visible(msg):
                param.setResult(None)
        except Exception:
            pass


class ChatContentFilterPlugin(BasePlugin):
    def on_plugin_load(self):
        self._loaded = True
        self.unhook_objs = []
        self.visible_days = set()
        self.visible_date_hashes = set()
        self._dates_initialized = False

        try:
            self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    item_id="chat_content_filter_action",
                    text="Filter Messages",
                    subtext="Open content filter options",
                    icon="msg_filter",
                    on_click=self.on_menu_action_click
                )
            )
        except Exception:
            pass

        self.apply_hooks()
        run_on_ui_thread(lambda: BulletinHelper.show_info("Chat Content Filter enabled"))

    def on_plugin_unload(self):
        self._loaded = False
        for unhook in getattr(self, "unhook_objs", []):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self.unhook_objs.clear()
        self.visible_days.clear()
        self.visible_date_hashes.clear()
        self._dates_initialized = False

        try:
            from client_utils import get_last_fragment
            fragment = get_last_fragment()
            if fragment and "ChatActivity" in fragment.getClass().getSimpleName():
                run_on_ui_thread(lambda: self.refresh_chat_view(fragment))
        except Exception:
            pass

