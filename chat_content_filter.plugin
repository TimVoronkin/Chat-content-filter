    from android.view import ViewConfiguration
    DEFAULT_LONG_PRESS_TIMEOUT = ViewConfiguration.getLongPressTimeout()
except Exception:
    DEFAULT_LONG_PRESS_TIMEOUT = 500

try:
    from android_utils import OnLongClickListener
except Exception:
    class OnLongClickListener(dynamic_proxy(find_class("android.view.View$OnLongClickListener"))):
        def __init__(self, callback):
            super().__init__()
            self.callback = callback

        def onLongClick(self, view):
            try:
                return bool(self.callback(view))
            except Exception:
                return True

try:
    from android.content import DialogInterface
    DialogInterfaceOnDismissListener = DialogInterface.OnDismissListener
except Exception:
    DialogInterfaceOnDismissListener = find_class("android.content.DialogInterface$OnDismissListener")

if DialogInterfaceOnDismissListener:
    class DialogDismissProxy(dynamic_proxy(DialogInterfaceOnDismissListener)):
        def __init__(self, callback):
            super().__init__()
            self.callback = callback

        def onDismiss(self, dialog):
            try:
                self.callback(dialog)
            except Exception:
                pass
else:
    DialogDismissProxy = None

